{
  "name": "keyfocus",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "optimize:audio": "node scripts/optimise-audio.mjs",
    "predev": "node scripts/optimise-audio.mjs",
    "build": "node scripts/optimise-audio.mjs && tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run --exclude 'e2e/**' --exclude '**/node_modules/**' && playwright test",
    "e2e": "playwright test",
    "e2e:coverage": "rm -rf .nyc_output coverage && E2E_COVERAGE=1 playwright test && nyc report --reporter=text --reporter=html --report-dir=coverage"
  },
  "dependencies": {
    "@editorjs/checklist": "^1.6.0",
    "@editorjs/code": "^2.9.4",
    "@editorjs/editorjs": "^2.31.6",
    "@editorjs/header": "^2.8.9",
    "@editorjs/image": "^2.10.3",
    "@editorjs/inline-code": "^1.5.2",
    "@editorjs/link": "^2.6.2",
    "@editorjs/list": "^2.0.9",
    "@editorjs/marker": "^1.4.0",
    "@editorjs/quote": "^2.7.6",
    "motion": "^12.43.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "autoprefixer": "^10.6.1",
    "jsdom": "^29.1.1",
    "nyc": "^18.0.0",
    "oxlint": "^1.89.0",
    "postcss": "^8.5.30",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vite-plugin-istanbul": "^9.0.1",
    "vitest": "^5.0.1"
  },
  "packageManager": "npm@12.2.0"
}
